build/
# local AI assistant instructions — keep private, not part of the public repo
CLAUDE.md
# raw demo videos — too big for git; the SD clip is attached to the GitHub Release
*.mov
*.MOV
*.o
*.elf
*.bin
# ...except the prebuilt firmware served by the browser flasher (GitHub Pages).
# The negation is not recursive, so the beta subdirectory needs its own line —
# without it the beta .bin files are silently ignored and beta.html 404s.
!docs/firmware/*.bin
!docs/firmware/beta/*.bin

# internal SDD scratch (progress ledger, review packages) — never publish
.superpowers/
# local editor/assistant config (launch.json for the docs preview server)
.claude/
